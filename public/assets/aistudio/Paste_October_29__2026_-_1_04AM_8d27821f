<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UsahaQu - Smart Order & Smart Stok</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; }
  </style>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <header class="bg-emerald-800 text-white shadow-md sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
      <div>
        <h1 id="appTitle" class="text-xl font-bold tracking-wider">UsahaQu</h1>
        <p id="appCategoryBadge" class="text-xs text-emerald-200">Smart POS & Manajemen Usaha</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openWizard()" class="bg-emerald-700 hover:bg-emerald-600 text-xs px-3 py-1.5 rounded-lg border border-emerald-600 transition flex items-center gap-1 shadow-inner">
          <i class="fa-solid fa-gear"></i> Ganti Kategori
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-4xl w-full mx-auto p-4 pb-24 space-y-4">

    <!-- Tab Navigation -->
    <div class="flex bg-gray-800 p-1 rounded-xl shadow border border-emerald-900/50">
      <button onclick="switchTab('pos')" id="tabPos" class="flex-1 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white transition">Kasir / Order</button>
      <button onclick="switchTab('stock')" id="tabStock" class="flex-1 py-2 text-sm font-semibold rounded-lg text-gray-400 hover:text-white transition">Smart Stok</button>
      <button onclick="switchTab('closing')" id="tabClosing" class="flex-1 py-2 text-sm font-semibold rounded-lg text-gray-400 hover:text-white transition">Closing / Rekap</button>
    </div>

    <!-- TAB 1: KASIR / SMART ORDER -->
    <section id="sectionPos" class="space-y-4">
      <!-- Voice Order & Input Utama -->
      <div class="bg-gray-800 p-4 rounded-2xl shadow-lg border border-emerald-900/40">
        <div class="flex justify-between items-center mb-3">
          <h2 class="font-bold text-sm text-emerald-400 flex items-center gap-2"><i class="fa-solid fa-microphone text-emerald-500"></i> Smart Order (Suara / Ketik)</h2>
          <span class="text-xs text-gray-400" id="currentDynamicFieldLabel">No. Meja</span>
        </div>
        <div class="flex gap-2 mb-3">
          <input type="text" id="dynamicFieldInput" placeholder="No. Meja / Nopol / Member" class="w-1/3 bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
          <input type="text" id="voiceCommandInput" placeholder='Contoh: "Ayam Bakar 2, Es Teh 1"' class="flex-1 bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
          <button onclick="toggleSpeechRecognition()" id="micBtn" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl transition shadow flex items-center justify-center">
            <i class="fa-solid fa-microphone text-base"></i>
          </button>
        </div>
        <div class="flex justify-between items-center text-xs text-gray-400">
          <span id="speechStatus">Mikrofon siap digunakan. Klik mic atau ketik pesanan.</span>
          <button onclick="processVoiceOrder()" class="bg-gray-700 hover:bg-gray-600 text-emerald-300 px-3 py-1 rounded-lg">Proses Teks</button>
        </div>
      </div>

      <!-- Grid Produk & Keranjang (2 Kolom di Desktop, Stack di Mobile) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Katalog Produk -->
        <div class="bg-gray-800 p-4 rounded-2xl shadow border border-emerald-900/40 flex flex-col">
          <div class="flex justify-between items-center mb-3">
            <h3 class="font-bold text-sm text-gray-200">Katalog Produk</h3>
            <input type="text" id="searchCatalog" oninput="renderCatalog()" placeholder="Cari produk..." class="bg-gray-900 border border-gray-700 text-xs px-2.5 py-1.5 rounded-lg w-36 text-white">
          </div>
          <div id="catalogGrid" class="grid grid-cols-2 gap-2 overflow-y-auto max-h-72 pr-1">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- Keranjang Belanja -->
        <div class="bg-gray-800 p-4 rounded-2xl shadow border border-emerald-900/40 flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-sm text-gray-200 mb-3 flex justify-between items-center">
              <span>Keranjang Pesanan</span>
              <button onclick="clearCart()" class="text-xs text-rose-400 hover:underline">Kosongkan</button>
            </h3>
            <div id="cartList" class="space-y-2 overflow-y-auto max-h-52 pr-1 mb-3">
              <p class="text-xs text-gray-500 text-center py-6">Keranjang masih kosong.</p>
            </div>
          </div>

          <div class="border-t border-gray-700 pt-3 space-y-1.5 text-sm">
            <div class="flex justify-between text-gray-400 text-xs">
              <span>Subtotal</span>
              <span id="subtotalDisplay">Rp 0</span>
            </div>
            <div class="flex justify-between text-emerald-400 text-xs">
              <span>Biaya Layanan Sistem (Auto 1%)</span>
              <span id="serviceFeeDisplay">Rp 0</span>
            </div>
            <div class="flex justify-between font-bold text-base text-white pt-1 border-t border-gray-700">
              <span>Total Akhir</span>
              <span id="grandTotalDisplay" class="text-emerald-400">Rp 0</span>
            </div>
            <div class="grid grid-cols-3 gap-2 pt-2">
              <button onclick="checkout('save')" class="bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-semibold py-2.5 rounded-xl transition shadow">Simpan</button>
              <button onclick="checkout('wa')" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold py-2.5 rounded-xl transition shadow">Kirim WA</button>
              <button onclick="checkout('print')" class="bg-gray-700 hover:bg-gray-600 text-white text-xs font-semibold py-2.5 rounded-xl transition shadow">Cetak</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 2: SMART STOK & KATALOG -->
    <section id="sectionStock" class="space-y-4 hidden">
      <div class="bg-gray-800 p-4 rounded-2xl shadow border border-emerald-900/40">
        <h2 class="font-bold text-sm text-emerald-400 mb-3"><i class="fa-solid fa-boxes-stacked"></i> Manajemen Stok & Produk Baru</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-3">
          <input type="text" id="newProdName" placeholder="Nama Produk" class="bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white">
          <input type="number" id="newProdPrice" placeholder="Harga (Rp)" class="bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white">
          <input type="number" id="newProdStock" placeholder="Stok Awal" class="bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white">
        </div>
        <button onclick="addNewProduct()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold py-2.5 rounded-xl transition shadow">Tambah Produk ke Katalog</button>
      </div>

      <div class="bg-gray-800 p-4 rounded-2xl shadow border border-emerald-900/40">
        <h3 class="font-bold text-sm text-gray-200 mb-3">Daftar Stok Saat Ini</h3>
        <div id="stockListContainer" class="space-y-2 overflow-y-auto max-h-96 pr-1">
          <!-- Rendered by JS -->
        </div>
      </div>
    </section>

    <!-- TAB 3: CLOSING KASIR & AUTO BILLING -->
    <section id="sectionClosing" class="space-y-4 hidden">
      <div class="bg-gray-800 p-4 rounded-2xl shadow border border-emerald-900/40 space-y-4">
        <div>
          <h2 class="font-bold text-base text-emerald-400"><i class="fa-solid fa-cash-register"></i> Rekap Closing Harian</h2>
          <p class="text-xs text-gray-400">Laporan transaksi harian & akumulasi kontribusi biaya layanan sistem (1%).</p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="bg-gray-900 p-3 rounded-xl border border-gray-700">
            <span class="text-xs text-gray-400">Total Transaksi Hari Ini</span>
            <p id="closingTotalTrx" class="text-lg font-bold text-white">0 Transaksi</p>
          </div>
          <div class="bg-gray-900 p-3 rounded-xl border border-gray-700">
            <span class="text-xs text-gray-400">Omset Penjualan</span>
            <p id="closingTotalOmset" class="text-lg font-bold text-emerald-400">Rp 0</p>
          </div>
        </div>

        <div class="bg-emerald-950/40 p-4 rounded-xl border border-emerald-800/60 space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-emerald-200">Akumulasi Biaya Layanan Sistem (1%):</span>
            <span id="closingUnpaidFee" class="font-bold text-emerald-400">Rp 0</span>
          </div>
          <p class="text-xs text-gray-400">Biaya layanan terakumulasi otomatis. Jika mencapai ≥ Rp 10.000, sistem akan meminta pembayaran kontribusi via QRIS saat closing.</p>
        </div>

        <button onclick="triggerClosingProcess()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl transition shadow flex items-center justify-center gap-2">
          <i class="fa-solid fa-file-invoice-dollar"></i> Proses Closing & Kirim Rekap
        </button>
      </div>

      <div class="bg-gray-800 p-4 rounded-2xl shadow border border-emerald-900/40">
        <h3 class="font-bold text-sm text-gray-200 mb-3">Riwayat Transaksi Tersimpan</h3>
        <div id="historyListContainer" class="space-y-2 overflow-y-auto max-h-64 pr-1 text-xs">
          <p class="text-gray-500 text-center py-4">Belum ada riwayat transaksi.</p>
        </div>
      </div>
    </section>

  </main>

  <!-- MODAL SETUP WIZARD (ONBOARDING) -->
  <div id="wizardModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-gray-800 border border-emerald-900/60 rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div>
        <h2 class="text-lg font-bold text-white">Konfigurasi UsahaQu</h2>
        <p class="text-xs text-gray-400">Suaikan aplikasi dengan kategori bisnismu</p>
      </div>

      <div class="space-y-3">
        <label class="block text-xs font-semibold text-gray-300">Pilih Jenis / Kategori Usaha:</label>
        <div class="grid grid-cols-2 gap-2">
          <button onclick="selectCategory('FNB')" id="catBtnFNB" class="p-3 text-left bg-gray-900 border border-emerald-500 rounded-xl transition category-btn">
            <p class="font-bold text-xs text-white">Kuliner / F&B</p>
            <p class="text-[10px] text-gray-400">Resto, Cafe (No. Meja)</p>
          </button>
          <button onclick="selectCategory('RETAIL')" id="catBtnRETAIL" class="p-3 text-left bg-gray-900 border border-gray-700 rounded-xl transition category-btn">
            <p class="font-bold text-xs text-white">Ritel / Toko</p>
            <p class="text-[10px] text-gray-400">Warung, Minimarket</p>
          </button>
          <button onclick="selectCategory('SERVICE')" id="catBtnSERVICE" class="p-3 text-left bg-gray-900 border border-gray-700 rounded-xl transition category-btn">
            <p class="font-bold text-xs text-white">Jasa / Servis</p>
            <p class="text-[10px] text-gray-400">Bengkel, Laundry (Nopol)</p>
          </button>
          <button onclick="selectCategory('RENTAL')" id="catBtnRENTAL" class="p-3 text-left bg-gray-900 border border-gray-700 rounded-xl transition category-btn">
            <p class="font-bold text-xs text-white">Sewa / Rental</p>
            <p class="text-[10px] text-gray-400">Kamera, Alat (Durasi)</p>
          </button>
        </div>

        <div class="space-y-2 pt-2">
          <div>
            <label class="block text-xs text-gray-400 mb-1">Nama Usaha / Toko</label>
            <input type="text" id="setupStoreName" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white" placeholder="Contoh: Kedai Bageur">
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Satuan Produk Utama</label>
            <input type="text" id="setupUnit" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white" placeholder="porsi / pcs / unit / jam">
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">No. WhatsApp Toko / Pemilik</label>
            <input type="text" id="setupWa" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white" placeholder="08123456789">
          </div>
        </div>
      </div>

      <div class="pt-2 flex gap-2">
        <button onclick="saveWizardSetup()" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl text-sm transition shadow">Simpan & Mulai</button>
      </div>
    </div>
  </div>

  <!-- MODAL QRIS PEMBAYARAN BIAYA LAYANAN (AUTO-CLOSING) -->
  <div id="qrisModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-gray-800 border border-emerald-900/60 rounded-3xl max-w-sm w-full p-6 shadow-2xl text-center space-y-4">
      <div>
        <h3 class="text-base font-bold text-white">Pembayaran Biaya Layanan</h3>
        <p class="text-xs text-gray-400 mt-1">Akumulasi biaya layanan sistem mencapai ambang batas minimum. Selesaikan pembayaran via QRIS untuk melanjutkan.</p>
      </div>

      <div class="bg-white p-3 rounded-2xl inline-block shadow-inner">
        <!-- Placeholder QRIS Developer -->
        <div class="w-48 h-48 bg-gray-200 flex flex-col items-center justify-center text-gray-700 font-bold rounded-lg border border-dashed border-gray-400 p-2 text-center">
          <i class="fa-solid fa-qrcode text-5xl mb-2 text-emerald-700"></i>
          <span class="text-xs">QRIS KONTRIBUSI SISTEM</span>
          <span id="qrisNominalBadge" class="text-sm font-extrabold text-rose-600 mt-1">Rp 10.000</span>
        </div>
      </div>

      <p class="text-[11px] text-gray-400">Scan QRIS di atas menggunakan m-Banking atau E-Wallet apa saja, lalu klik tombol konfirmasi setelah berhasil.</p>

      <div class="flex gap-2 pt-2">
        <button onclick="confirmQrisPayment()" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl text-xs transition shadow">Sudah Bayar via QRIS</button>
        <button onclick="closeQrisModal()" class="bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold py-2.5 px-4 rounded-xl text-xs transition">Nanti</button>
      </div>
    </div>
  </div>

  <!-- JavaScript Aplikasi -->
  <script>
    // State Aplikasi
    let appData = JSON.parse(localStorage.getItem('usahaqu_data')) || {
      category: 'FNB',
      storeName: 'Kedai Bageur',
      unit: 'porsi',
      wa: '08123456789',
      developerWa: '6281234567890', // Nomor WA Kamu untuk terima rekap
      unpaidFee: 0,
      products: [
        { id: 'P01', name: 'Ayam Bakar Madu', price: 25000, stock: 15 },
        { id: 'P02', name: 'Es Teh Manis', price: 5000, stock: 40 },
        { id: 'P03', name: 'Nasi Putih', price: 5000, stock: 50 },
        { id: 'P04', name: 'Tahu Tempe Goreng', price: 4000, stock: 30 }
      ],
      cart: [],
      transactions: []
    };

    let selectedCategoryState = appData.category || 'FNB';

    // Inisialisasi Saat Load
    window.onload = function() {
      if (!localStorage.getItem('usahaqu_data')) {
        openWizard();
      } else {
        applyCategoryUI();
        renderCatalog();
        renderCart();
        renderStockList();
        renderHistory();
        updateClosingStats();
      }
    };

    // Navigasi Tab
    function switchTab(tab) {
      document.getElementById('sectionPos').classList.add('hidden');
      document.getElementById('sectionStock').classList.add('hidden');
      document.getElementById('sectionClosing').classList.add('hidden');
      document.getElementById('tabPos').className = 'flex-1 py-2 text-sm font-semibold rounded-lg text-gray-400 hover:text-white transition';
      document.getElementById('tabStock').className = 'flex-1 py-2 text-sm font-semibold rounded-lg text-gray-400 hover:text-white transition';
      document.getElementById('tabClosing').className = 'flex-1 py-2 text-sm font-semibold rounded-lg text-gray-400 hover:text-white transition';

      if(tab === 'pos') {
        document.getElementById('sectionPos').classList.remove('hidden');
        document.getElementById('tabPos').className = 'flex-1 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white transition';
      } else if(tab === 'stock') {
        document.getElementById('sectionStock').classList.remove('hidden');
        document.getElementById('tabStock').className = 'flex-1 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white transition';
        renderStockList();
      } else if(tab === 'closing') {
        document.getElementById('sectionClosing').classList.remove('hidden');
        document.getElementById('tabClosing').className = 'flex-1 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white transition';
        updateClosingStats();
      }
    }

    // Wizard Setup
    function openWizard() {
      document.getElementById('setupStoreName').value = appData.storeName;
      document.getElementById('setupUnit').value = appData.unit;
      document.getElementById('setupWa').value = appData.wa;
      selectCategory(appData.category || 'FNB');
      document.getElementById('wizardModal').classList.remove('hidden');
    }

    function selectCategory(cat) {
      selectedCategoryState = cat;
      document.querySelectorAll('.category-btn').forEach(btn => btn.className = 'p-3 text-left bg-gray-900 border border-gray-700 rounded-xl transition category-btn');
      const activeBtn = document.getElementById('catBtn' + cat);
      if(activeBtn) activeBtn.className = 'p-3 text-left bg-gray-900 border border-emerald-500 rounded-xl transition category-btn shadow';
    }

    function saveWizardSetup() {
      appData.category = selectedCategoryState;
      appData.storeName = document.getElementById('setupStoreName').value || 'UsahaQu Store';
      appData.unit = document.getElementById('setupUnit').value || 'pcs';
      appData.wa = document.getElementById('setupWa').value || '08123456789';
      
      saveData();
      applyCategoryUI();
      document.getElementById('wizardModal').classList.add('hidden');
      renderCatalog();
    }

    function applyCategoryUI() {
      document.getElementById('appTitle').innerText = appData.storeName;
      let label = "No. Meja";
      if(appData.category === 'RETAIL') label = "No. Member";
      else if(appData.category === 'SERVICE') label = "No. Polisi / Nopol";
      else if(appData.category === 'RENTAL') label = "Durasi / Jaminan";
      
      document.getElementById('currentDynamicFieldLabel').innerText = label;
      document.getElementById('dynamicFieldInput').placeholder = label;
      document.getElementById('appCategoryBadge').innerText = `Kategori: ${appData.category} (${appData.unit})`;
    }

    function saveData() {
      localStorage.setItem('usahaqu_data', JSON.stringify(appData));
    }

    // Katalog & POS
    function renderCatalog() {
      const query = document.getElementById('searchCatalog').value.toLowerCase();
      const container = document.getElementById('catalogGrid');
      container.innerHTML = '';

      const filtered = appData.products.filter(p => p.name.toLowerCase().includes(query));
      if(filtered.length === 0) {
        container.innerHTML = '<p class="text-xs text-gray-500 col-span-2 text-center py-4">Produk tidak ditemukan.</p>';
        return;
      }

      filtered.forEach(p => {
        container.innerHTML += `
          <div onclick="addToCart('${p.id}')" class="bg-gray-900 border border-gray-700/60 hover:border-emerald-500 p-2.5 rounded-xl cursor-pointer transition flex flex-col justify-between">
            <div>
              <p class="font-bold text-xs text-white truncate">${p.name}</p>
              <p class="text-[11px] text-emerald-400 font-semibold">Rp ${p.price.toLocaleString('id-ID')}</p>
            </div>
            <div class="flex justify-between items-center mt-2 text-[10px] text-gray-400">
              <span>Stok: ${p.stock}</span>
              <span class="bg-emerald-950 text-emerald-300 px-1.5 py-0.5 rounded">+ Tambah</span>
            </div>
          </div>
        `;
      });
    }

    function addToCart(id) {
      const prod = appData.products.find(p => p.id === id);
      if(!prod || prod.stock <= 0) {
        alert('Stok produk habis!');
        return;
      }
      const existing = appData.cart.find(item => item.id === id);
      if(existing) {
        if(existing.qty < prod.stock) {
          existing.qty++;
          existing.subtotal = existing.qty * existing.price;
        } else {
          alert('Stok tidak mencukupi!');
        }
      } else {
        appData.cart.push({ id: prod.id, name: prod.name, price: prod.price, qty: 1, subtotal: prod.price });
      }
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById('cartList');
      container.innerHTML = '';

      if(appData.cart.length === 0) {
        container.innerHTML = '<p class="text-xs text-gray-500 text-center py-6">Keranjang masih kosong.</p>';
        updateTotals();
        return;
      }

      appData.cart.forEach((item, index) => {
        container.innerHTML += `
          <div class="flex justify-between items-center bg-gray-900 p-2 rounded-xl border border-gray-700/50 text-xs">
            <div class="flex-1">
              <p class="font-bold text-white">${item.name}</p>
              <p class="text-emerald-400">Rp ${item.price.toLocaleString('id-ID')} x ${item.qty}</p>
            </div>
            <div class="flex items-center gap-1.5">
              <button onclick="updateQty(${index}, -1)" class="bg-gray-700 hover:bg-gray-600 w-6 h-6 rounded-lg text-white font-bold">-</button>
              <span class="w-5 text-center font-bold">${item.qty}</span>
              <button onclick="updateQty(${index}, 1)" class="bg-gray-700 hover:bg-gray-600 w-6 h-6 rounded-lg text-white font-bold">+</button>
            </div>
          </div>
        `;
      });
      updateTotals();
    }

    function updateQty(index, delta) {
      const item = appData.cart[index];
      const prod = appData.products.find(p => p.id === item.id);
      item.qty += delta;
      if(item.qty <= 0) {
        appData.cart.splice(index, 1);
      } else if(item.qty > prod.stock) {
        item.qty = prod.stock;
        alert('Stok maksimum tercapai!');
      }
      item.subtotal = item.qty * item.price;
      renderCart();
    }

    function clearCart() {
      appData.cart = [];
      renderCart();
    }

    function updateTotals() {
      const subtotal = appData.cart.reduce((sum, item) => sum + item.subtotal, 0);
      const serviceFee = Math.round(subtotal * 0.01); // Otomatis 1%
      const grandTotal = subtotal + serviceFee;

      document.getElementById('subtotalDisplay').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
      document.getElementById('serviceFeeDisplay').innerText = `Rp ${serviceFee.toLocaleString('id-ID')}`;
      document.getElementById('grandTotalDisplay').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
    }

    // Checkout & Auto Billing 1%
    function checkout(type) {
      if(appData.cart.length === 0) {
        alert('Keranjang masih kosong!');
        return;
      }

      const subtotal = appData.cart.reduce((sum, item) => sum + item.subtotal, 0);
      const serviceFee = Math.round(subtotal * 0.01);
      const grandTotal = subtotal + serviceFee;
      const dynamicVal = document.getElementById('dynamicFieldInput').value || '-';

      // Kurangi stok produk
      appData.cart.forEach(item => {
        const prod = appData.products.find(p => p.id === item.id);
        if(prod) prod.stock -= item.qty;
      });

      // Simpan transaksi
      const trx = {
        id: 'TRX-' + Date.now().toString().slice(-6),
        date: new Date().toLocaleString('id-ID'),
        meta: dynamicVal,
        items: [...appData.cart],
        subtotal,
        serviceFee,
        grandTotal
      };

      appData.transactions.unshift(trx);
      appData.unpaidFee += serviceFee; // Akumulasi otomatis biaya layanan ke background
      appData.cart = [];
      saveData();

      renderCatalog();
      renderCart();
      renderStockList();
      renderHistory();
      updateClosingStats();

      if(type === 'wa') {
        sendTransactionWA(trx);
      } else if(type === 'print') {
        alert('Struk berhasil dicetak (Simulasi Thermal Bluetooth).');
      } else {
        alert('Transaksi berhasil disimpan!');
      }
      document.getElementById('dynamicFieldInput').value = '';
    }

    function sendTransactionWA(trx) {
      let text = `*${appData.storeName}*\nNota: ${trx.id}\nWaktu: ${trx.date}\nCatatan: ${trx.meta}\n--------------------\n`;
      trx.items.forEach(i => {
        text += `${i.name} x${i.qty} = Rp ${i.subtotal.toLocaleString('id-ID')}\n`;
      });
      text += `--------------------\nTotal: Rp ${trx.grandTotal.toLocaleString('id-ID')}\nTerima Kasih!`;
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }

    // Smart Stok Management
    function renderStockList() {
      const container = document.getElementById('stockListContainer');
      container.innerHTML = '';

      appData.products.forEach(p => {
        container.innerHTML += `
          <div class="flex justify-between items-center bg-gray-900 p-2.5 rounded-xl border border-gray-700/50 text-xs">
            <div>
              <p class="font-bold text-white">${p.name}</p>
              <p class="text-emerald-400">Rp ${p.price.toLocaleString('id-ID')} | Stok: <span class="${p.stock < 5 ? 'text-rose-400 font-bold' : ''}">${p.stock}</span></p>
            </div>
            <div class="flex items-center gap-1">
              <button onclick="adjustStock('${p.id}', -1)" class="bg-gray-700 hover:bg-gray-600 px-2 py-1 rounded text-white">-</button>
              <button onclick="adjustStock('${p.id}', 5)" class="bg-emerald-700 hover:bg-emerald-600 px-2 py-1 rounded text-white">+5</button>
            </div>
          </div>
        `;
      });
    }

    function addNewProduct() {
      const name = document.getElementById('newProdName').value;
      const price = parseInt(document.getElementById('newProdPrice').value);
      const stock = parseInt(document.getElementById('newProdStock').value);

      if(!name || isNaN(price) || isNaN(stock)) {
        alert('Lengkapi data produk dengan benar!');
        return;
      }

      appData.products.push({ id: 'P' + Date.now().toString().slice(-4), name, price, stock });
      saveData();
      renderCatalog();
      renderStockList();

      document.getElementById('newProdName').value = '';
      document.getElementById('newProdPrice').value = '';
      document.getElementById('newProdStock').value = '';
      alert('Produk berhasil ditambahkan!');
    }

    function adjustStock(id, amount) {
      const prod = appData.products.find(p => p.id === id);
      if(prod) {
        prod.stock += amount;
        if(prod.stock < 0) prod.stock = 0;
        saveData();
        renderStockList();
        renderCatalog();
      }
    }

    // Voice Order Parser
    let recognition;
    function toggleSpeechRecognition() {
      const statusEl = document.getElementById('speechStatus');
      if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Browser Anda tidak mendukung pengenalan suara.');
        return;
      }

      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.lang = 'id-ID';
      recognition.start();

      statusEl.innerText = "Mendengarkan suara...";
      document.getElementById('micBtn').className = "bg-rose-600 text-white px-4 py-2 rounded-xl transition shadow animate-pulse";

      recognition.onresult = function(event) {
        const text = event.results[0][0].transcript;
        document.getElementById('voiceCommandInput').value = text;
        statusEl.innerText = `Terdeteksi: "${text}"`;
        document.getElementById('micBtn').className = "bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl transition shadow";
        processVoiceOrderText(text);
      };

      recognition.onerror = function() {
        statusEl.innerText = "Gagal mendengarkan suara. Coba ketik manual.";
        document.getElementById('micBtn').className = "bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl transition shadow";
      };
    }

    function processVoiceOrder() {
      const text = document.getElementById('voiceCommandInput').value;
      processVoiceOrderText(text);
    }

    function processVoiceOrderText(text) {
      const lower = text.toLowerCase();
      appData.products.forEach(p => {
        if(lower.includes(p.name.toLowerCase())) {
          // Cari angka setelah nama produk atau default 1
          addToCart(p.id);
        }
      });
    }

    // Closing & Auto Billing QRIS Trigger
    function updateClosingStats() {
      const totalTrx = appData.transactions.length;
      const totalOmset = appData.transactions.reduce((sum, t) => sum + t.grandTotal, 0);

      document.getElementById('closingTotalTrx').innerText = `${totalTrx} Transaksi`;
      document.getElementById('closingTotalOmset').innerText = `Rp ${totalOmset.toLocaleString('id-ID')}`;
      document.getElementById('closingUnpaidFee').innerText = `Rp ${appData.unpaidFee.toLocaleString('id-ID')}`;
    }

    function renderHistory() {
      const container = document.getElementById('historyListContainer');
      container.innerHTML = '';
      if(appData.transactions.length === 0) {
        container.innerHTML = '<p class="text-gray-500 text-center py-4">Belum ada riwayat transaksi.</p>';
        return;
      }

      appData.transactions.forEach(trx => {
        container.innerHTML += `
          <div class="bg-gray-900 p-2.5 rounded-xl border border-gray-700/50 flex justify-between items-center">
            <div>
              <p class="font-bold text-white">${trx.id} (${trx.date})</p>
              <p class="text-gray-400">Item: ${trx.items.length} | Layanan (1%): Rp ${trx.serviceFee.toLocaleString('id-ID')}</p>
            </div>
            <p class="font-bold text-emerald-400">Rp ${trx.grandTotal.toLocaleString('id-ID')}</p>
          </div>
        `;
      });
    }

    function triggerClosingProcess() {
      updateClosingStats();
      // Threshold 10.000 untuk memunculkan QRIS pembayaran otomatis
      if(appData.unpaidFee >= 10000) {
        document.getElementById('qrisNominalBadge').innerText = `Rp ${appData.unpaidFee.toLocaleString('id-ID')}`;
        document.getElementById('qrisModal').classList.remove('hidden');
      } else {
        sendDeveloperReport();
      }
    }

    function confirmQrisPayment() {
      sendDeveloperReport();
      appData.unpaidFee = 0; // Reset akumulasi setelah bayar
      saveData();
      updateClosingStats();
      document.getElementById('qrisModal').classList.add('hidden');
      alert('Pembayaran biaya layanan berhasil dikonfirmasi. Terima kasih!');
    }

    function closeQrisModal() {
      document.getElementById('qrisModal').classList.add('hidden');
    }

    function sendDeveloperReport() {
      const totalOmset = appData.transactions.reduce((sum, t) => sum + t.grandTotal, 0);
      let reportText = `📊 REKAP BIAYA LAYANAN USAHAQU\n----------------------------------\nToko: ${appData.storeName}\nTotal Transaksi: ${appData.transactions.length}\nTotal Omset: Rp ${totalOmset.toLocaleString('id-ID')}\nKontribusi Layanan (1%): Rp ${appData.unpaidFee.toLocaleString('id-ID')}\nStatus: [ LUNAS / TERCATAT ]\n----------------------------------`;
      
      window.open(`https://wa.me/${appData.developerWa}?text=${encodeURIComponent(reportText)}`, '_blank');
    }
  </script>
</body>
</html>